# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Secrets / credentials — never commit these
*.pem
golf-outing-*.json

# Ignore all JSON by default so a stray credentials/key file can never be
# committed, then explicitly allow the non-secret config files the app needs.
*.json
!event_2026.json
!event_2026_draft.json
!players_2025.json
!players_2026.json
!courses.json

# 2025 regression fixtures used by jdcvo/test_2025_validation.py
!golf_scores_round*.json
!round_*_results.json
!round_5_handicaps.json
!puttoff_results.json
!extras_r*_results.json
!adjustment_results.json

# Working data: regenerated by the pipeline, and live inputs come from Google
# Sheets, so this stays out of git. (If you later decide you want history
# snapshots committed for extra recoverability, add:  !data_2026/history/ )
data_2026/

# Synthetic scores from tools/make_fake_scores.py. They're deterministic from a
# seed, so there's nothing worth preserving, and fake results must never be
# mistaken for real ones in the repo.
data_2026_draft/

# Event log files (kept local; not meant for the repo)
golf_outing_*.log

# Stale duplicate working copy from 2025: it has its OWN .git (same remote) and
# its own copies of the service-account key + .pem. Keep it entirely out of this
# repo. (Consider deleting it, and never `git push` from inside it.)
Golf Outing copy/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
